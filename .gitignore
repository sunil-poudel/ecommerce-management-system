target/
build/
*.class
*.jar
*.war
*.ear

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE & Editor files
.idea/
*.iws
*.iml
*.ipr
.vscode/
