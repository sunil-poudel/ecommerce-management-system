# Uploads directory (keep folder structure via .gitkeep, ignore actual user assets)
uploads/*
!uploads/.gitkeep

# Database backups & local dumps
db_backups/
*.sql

# Environment variable files (keep .example files)
.env
.env.local
.env.*.local

# Log files
*.log
logs/

# Operating system artifacts
.DS_Store
Thumbs.db
