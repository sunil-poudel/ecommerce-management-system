# =================================================================
# E-Commerce & Retail Management System - Environment Configuration
# =================================================================
# Copy this file to .env or export these variables in your environment.

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_backend
DB_USER=root
DB_PASSWORD=root

# Security & Authentication (Base64-encoded 256-bit HMAC secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost

# Mail / SMTP Configuration (for OTP verification and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# AI Integration (Optional - Google Gemini API Key for phonetic search)
GEMINI_API_KEY=

# Automated Database Backup Scheduler (Optional)
BACKUP_ENABLED=false
BACKUP_DIR=./db_backups
